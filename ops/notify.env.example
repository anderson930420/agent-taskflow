# Copy to ops/notify.env and fill in the real values.
# ops/notify.env is gitignored and MUST NOT be committed.
#
#   cp ops/notify.env.example ops/notify.env
#   chmod 600 ops/notify.env

# Discord incoming webhook that receives taskflow status transitions.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME

# Optional overrides; the defaults in run_notify.sh match the VPS layout.
#TASKFLOW_DB_PATH=$HOME/.agent-taskflow/state/github_issue_scheduler.sqlite3
#TASKFLOW_ARTIFACT_ROOT=$HOME/agent-taskflow/artifacts/github-issue-scheduler
#TASKFLOW_NOTIFY_STATE=$HOME/agent-taskflow-ops/notify_state.json
